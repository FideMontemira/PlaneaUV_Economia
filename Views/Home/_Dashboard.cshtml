<!-- ============ ALUMNO ============ -->
<div class="card app-card mt-3 mb-3">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">

        <!-- Cambiar de alumno -->
        <div class="dropdown">
            <button class="btn btn-outline-primary fw-bold dropdown-toggle" type="button" id="dropdownAlumnos" data-bs-toggle="dropdown" aria-expanded="false" title="Ver alumnos guardados">
                <i class="bi bi-person-lines-fill me-1"></i>Alumnos
            </button>
            <ul class="dropdown-menu shadow" aria-labelledby="dropdownAlumnos" id="listaAlumnosRegistrados">
                <li><span class="dropdown-item-text text-muted">Cargando...</span></li>
            </ul>
        </div>

        <!-- Identidad del alumno (son inputs de solo lectura porque el JS lee y escribe su .value) -->
        <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 260px;">
            <div class="alumno-avatar"><i class="bi bi-person-fill"></i></div>
            <div class="flex-grow-1">
                <input type="text" id="inputNombreAlumno" class="form-control-plaintext alumno-nombre" placeholder="Sin alumno seleccionado" readonly aria-label="Nombre del alumno">
                <div class="d-flex align-items-center gap-1 text-muted small">
                    <i class="bi bi-person-vcard"></i>
                    <input type="text" id="inputMatricula" class="form-control-plaintext alumno-matricula" placeholder="Matrícula" readonly aria-label="Matrícula">
                </div>
            </div>
        </div>

        <!-- Semáforo de riesgo: lo calcula el servidor (Services/ReglasSemaforo.cs); clic para ver las señales y valorarlo -->
        <div>
            <label class="app-etiqueta">Semáforo de riesgo</label>
            <button type="button" id="semaforoAlumno" class="semaforo-boton semaforo-sin" onclick="abrirModalTutorias()" title="Selecciona un alumno">
                <span class="semaforo-punto"></span><span id="textoSemaforoAlumno">—</span>
            </button>
        </div>

        <!-- Situación académica -->
        <div>
            <label class="app-etiqueta" for="selectSituacionAlumno">Situación académica</label>
            <select class="form-select form-select-sm fw-bold" id="selectSituacionAlumno" onchange="marcarCambios()" style="min-width: 160px;">
                <option value="Activo">🟢 Activo</option>
                <option value="Baja Temporal">🟡 Baja Temporal</option>
                <option value="Baja Definitiva">🔴 Baja Definitiva</option>
            </select>
        </div>

        <!-- Periodo que cursa: se calcula con el año de ingreso de la matrícula (S21 = 2021) y el Periodo de Trabajo -->
        <div>
            <label class="app-etiqueta">Periodo que cursa</label>
            <div class="d-flex gap-1">
                <div id="infoPeriodoAlumno" class="form-control form-control-sm fw-bold bg-light text-muted" style="min-width: 150px;">—</div>
                <!-- Periodos sin inscripción (bajas temporales): no cuentan para saber en qué periodo va -->
                <button type="button" class="btn btn-sm btn-outline-secondary" onclick="abrirModalPausas()" title="Registrar periodos sin inscripción (bajas temporales)">
                    <i class="bi bi-pause-circle"></i>
                </button>
            </div>
        </div>

        <!-- Acciones del alumno -->
        <div class="d-flex gap-2 ms-lg-auto">
            <button class="btn btn-outline-info fw-bold" type="button" onclick="abrirModalTutorias()" title="Registro de sesiones de tutoría">
                <i class="bi bi-journal-text me-1"></i>Tutorías
            </button>
            <button type="button" class="btn btn-success fw-bold" onclick="abrirSugerenciaCarga()" title="Materias que le conviene inscribir al alumno">
                <i class="bi bi-lightbulb-fill me-1"></i>Sugerir carga
            </button>
        </div>
    </div>
</div>

<!-- ============ INDICADORES ============ -->
<div class="row g-3 mb-3">

    <!-- Avance global y contadores -->
    <div class="col-12 col-xl-5">
        <div class="card app-card h-100">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-around gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="progress-circle" id="graficaAvance">
                        <div class="progress-circle-inner">
                            <span id="textoPorcentaje" class="fw-bold fs-5 text-dark mb-0">0%</span>
                        </div>
                    </div>
                    <div>
                        <div class="app-etiqueta mb-0">Avance en créditos</div>
                        <span id="textoCreditos" class="text-primary fw-bold fs-5">0 Cr.</span>
                        <!-- Avance frente a las trayectorias estándar y larga (los créditos esperados los calcula el servidor) -->
                        <div id="trayectoriaAlumno" class="trayectoria d-none"></div>
                    </div>
                </div>

                <div class="indicador">
                    <div class="indicador-numero text-info"><i class="bi bi-book-half me-1"></i><span id="textoCurso">0</span></div>
                    <div class="app-etiqueta mb-0">Cursando</div>
                </div>
                <div class="indicador">
                    <div class="indicador-numero text-warning"><i class="bi bi-exclamation-triangle-fill me-1"></i><span id="textoRiesgo">0</span></div>
                    <div class="app-etiqueta mb-0">En riesgo</div>
                </div>
                <div class="indicador" title="Materias de periodos anteriores al que cursa que aún no aprueba">
                    <div class="indicador-numero text-secondary"><i class="bi bi-hourglass-split me-1"></i><span id="textoRezago">0</span></div>
                    <div class="app-etiqueta mb-0">En rezago</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Avance por área: una gráfica por cada tipo de materia del plan (las dibuja el JS: dibujarGraficasPorArea) -->
    <div class="col-12 col-xl-7">
        <div class="card app-card h-100">
            <div class="card-body">
                <div class="app-etiqueta mb-2"><i class="bi bi-pie-chart-fill me-1"></i>Avance por área (créditos aprobados)</div>
                <div id="graficasAreas" class="d-flex flex-wrap justify-content-around gap-3">
                    <span class="text-muted small">Selecciona un alumno para ver su avance por área.</span>
                </div>
            </div>
        </div>
    </div>
</div>
