<div class="card my-4 shadow-sm">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div class="d-flex gap-2 flex-grow-1 align-items-end">
            <div class="dropdown">
                <button class="btn btn-outline-secondary fs-5 py-1 px-2 mb-1" type="button" id="dropdownAlumnos" data-bs-toggle="dropdown" aria-expanded="false" style="border: none;">
                    ⋮
                </button>
                <ul class="dropdown-menu shadow" aria-labelledby="dropdownAlumnos" id="listaAlumnosRegistrados">
                    <li><span class="dropdown-item-text text-muted">Cargando...</span></li>
                </ul>
            </div>

            <div style="max-width: 150px;">
                <label class="form-label fw-bold">Matrícula:</label>
                <input type="text" id="inputMatricula" class="form-control" placeholder="Matrícula" readonly>
            </div>
            <div class="flex-grow-1" style="max-width: 300px;">
                <label class="form-label fw-bold">Nombre del Alumno:</label>
                <input type="text" id="inputNombreAlumno" class="form-control" placeholder="Nombre completo" readonly>
            </div>
        </div>

        <div class="d-flex align-items-center gap-4 bg-light p-2 px-4 rounded border">
            <div class="d-flex align-items-center gap-3">
                <div class="progress-circle" id="graficaAvance">
                    <div class="progress-circle-inner">
                        <span id="textoPorcentaje" class="fw-bold fs-5 text-dark mb-0">0%</span>
                    </div>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-muted" style="font-size: 0.85rem;">AVANCE CREDITICIO</h6>
                    <span id="textoCreditos" class="text-primary fw-bold" style="font-size: 1.15rem;">0 / 348 Cr.</span>
                </div>
            </div>

            <div class="vr bg-secondary" style="width: 2px;"></div>

            <div class="d-flex align-items-center gap-2">
                <div class="curso-circle shadow-sm">
                    <span id="textoCurso" class="text-info fw-bold mb-0" style="font-size: 1.3rem;">0</span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-info" style="font-size: 0.85rem;">EN CURSO</h6>
                    <span class="text-muted fw-bold" style="font-size: 0.75rem;">Materias</span>
                </div>
            </div>

            <div class="vr bg-secondary" style="width: 2px;"></div>

            <div class="d-flex align-items-center gap-2">
                <div class="riesgo-circle shadow-sm">
                    <span id="textoRiesgo" class="text-danger fw-bold mb-0" style="font-size: 1.3rem;">0</span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-danger" style="font-size: 0.85rem;">EN RIESGO</h6>
                    <span class="text-muted fw-bold" style="font-size: 0.75rem;">Materias</span>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 h-100 align-items-stretch">
            <button class="btn btn-info fw-bold px-3 text-white" type="button" onclick="abrirModalTutorias()">
                <i class="bi bi-journal-text me-1"></i> Tutorías
            </button>
            <button class="btn fw-bold px-3 text-white" style="background-color: #6f42c1;" type="button" onclick="abrirReporteGlobal()">
                <i class="bi bi-bar-chart-line-fill me-1"></i> Reporte Global
            </button>

            <button class="btn btn-warning fw-bold px-3 position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAlertas" aria-controls="offcanvasAlertas" onclick="cargarAlertas()">
                <i class="bi bi-bell-fill"></i> Alertas
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="contadorAlertas" style="display: none;">
                    0
                </span>
            </button>
            <button class="btn btn-success fw-bold px-4" onclick="exportarAvance()">
                <i class="bi bi-save me-1"></i> Guardar
            </button>
        </div>
    </div>
</div>