<div class="card my-4 shadow-sm">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">

        <!-- Buscador y Datos Básicos -->
        <div class="d-flex gap-2 flex-grow-1 align-items-end">
            <div class="dropdown">
                <button class="btn btn-outline-secondary fs-5 py-1 px-2 mb-1" type="button" id="dropdownAlumnos" data-bs-toggle="dropdown" aria-expanded="false" style="border: none;" title="Ver alumnos guardados">
                    ⋮
                </button>
                <ul class="dropdown-menu shadow" aria-labelledby="dropdownAlumnos" id="listaAlumnosRegistrados">
                    <li><span class="dropdown-item-text text-muted">Cargando...</span></li>
                </ul>
            </div>

            <div style="max-width: 120px;">
                <label class="form-label fw-bold small mb-1">Matrícula:</label>
                <input type="text" id="inputMatricula" class="form-control form-control-sm fw-bold" placeholder="Matrícula" readonly>
            </div>
            <div class="flex-grow-1" style="max-width: 250px;">
                <label class="form-label fw-bold small mb-1">Nombre del Alumno:</label>
                <input type="text" id="inputNombreAlumno" class="form-control form-control-sm fw-bold" placeholder="Nombre completo" readonly>
            </div>

            <!-- NUEVO: Selector de Situación del Alumno -->
            <div style="max-width: 150px;">
                <label class="form-label fw-bold text-primary small mb-1">Situación Académica:</label>
                <select class="form-select form-select-sm border-primary" id="selectSituacionAlumno" onchange="marcarCambios()">
                    <option value="Activo">🟢 Activo</option>
                    <option value="Baja Temporal">🟡 Baja Temporal</option>
                    <option value="Baja Definitiva">🔴 Baja Definitiva</option>
                </select>
            </div>
        </div>

        <!-- Periodo Global -->
        <div class="bg-light p-2 rounded border border-secondary" style="min-width: 180px;">
            <label class="form-label fw-bold text-dark small mb-1"><i class="bi bi-calendar3"></i> Periodo de Trabajo:</label>
            <select class="form-select form-select-sm fw-bold" id="selectPeriodoGlobal">
                <!-- Se actualiza automáticamente al semestre actual, cubriendo histórico de la UV -->
                <option value="Agosto - Enero 2026">Agosto - Enero 2026</option>
                <option value="Febrero - Julio 2026">Febrero - Julio 2026</option>
                <option value="Agosto - Enero 2027" selected>Agosto - Enero 2027</option>
                <option value="Febrero - Julio 2027">Febrero - Julio 2027</option>
            </select>
        </div>

        <!-- Gráficas de Avance -->
        <div class="d-flex align-items-center gap-4 bg-light p-2 px-3 rounded border">
            <div class="d-flex align-items-center gap-3">
                <div class="progress-circle" id="graficaAvance">
                    <div class="progress-circle-inner">
                        <span id="textoPorcentaje" class="fw-bold fs-6 text-dark mb-0">0%</span>
                    </div>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-muted" style="font-size: 0.75rem;">CRÉDITOS</h6>
                    <span id="textoCreditos" class="text-primary fw-bold" style="font-size: 1rem;">0 / 441 Cr.</span>
                </div>
            </div>

            <div class="vr bg-secondary" style="width: 2px;"></div>

            <div class="d-flex align-items-center gap-2">
                <div class="curso-circle shadow-sm" style="width: 45px; height: 45px;">
                    <span id="textoCurso" class="text-info fw-bold mb-0" style="font-size: 1.1rem;">0</span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-info" style="font-size: 0.75rem;">CURSANDO</h6>
                </div>
            </div>

            <div class="vr bg-secondary" style="width: 2px;"></div>

            <div class="d-flex align-items-center gap-2">
                <div class="riesgo-circle shadow-sm" style="width: 45px; height: 45px;">
                    <span id="textoRiesgo" class="text-danger fw-bold mb-0" style="font-size: 1.1rem;">0</span>
                </div>
                <div>
                    <h6 class="mb-0 fw-bold text-danger" style="font-size: 0.75rem;">RIESGO</h6>
                </div>
            </div>
        </div>

        <!-- Botones de Acción -->
        <div class="d-flex gap-2 h-100 align-items-stretch">
            <button type="button" class="btn btn-dark fw-bold shadow-sm" onclick="abrirGestorPlanes()">
                <i class="bi bi-gear-fill me-1"></i> Planes
            </button>
            <button class="btn fw-bold px-3 text-white" style="background-color: #6f42c1;" type="button" onclick="abrirReporteGlobal()">
                <i class="bi bi-bar-chart-line-fill me-1"></i> Reportes
            </button>
            <button class="btn btn-info fw-bold px-3 text-white" type="button" onclick="abrirModalTutorias()">
                <i class="bi bi-journal-text me-1"></i> Tutorías
            </button>
            <button class="btn btn-warning fw-bold px-3 position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAlertas" onclick="cargarAlertas()">
                <i class="bi bi-bell-fill"></i> Alertas
                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="contadorAlertas" style="display: none;">0</span>
            </button>
            <button class="btn btn-success fw-bold px-4 shadow" onclick="exportarAvance()">
                <i class="bi bi-save me-1"></i> Guardar
            </button>
        </div>
    </div>
</div>