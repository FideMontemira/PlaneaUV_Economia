            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Mexicana I" data-creditos="8">
                <strong>Economía Mexicana I</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Técnicas de Investigación" data-creditos="8">
                <strong>Técnicas de Invest.</strong><br />(8 Cr.)
            </div>
        </div>

        <!-- 5to Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">5to Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Organización Industrial" data-creditos="8" data-prerequisito="Microeconomía II">
                <strong>Organización Industrial</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Microeconomía II</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Microeconomía III" data-creditos="9" data-prerequisito="Microeconomía II">
                <strong>Microeconomía III</strong><br />(9 Cr.)
                <span class="prerequisito-text">Req: Microeconomía II</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Macroeconomía II" data-creditos="10" data-prerequisito="Macroeconomía I">
                <strong>Macroeconomía II</strong><br />(10 Cr.)
                <span class="prerequisito-text">Req: Macroeconomía I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Econometría I" data-creditos="8" data-prerequisito="Estadística">
                <strong>Econometría I</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Estadística</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Modelos Dinámicos" data-creditos="8">
                <strong>Modelos Dinámicos</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Mexicana II" data-creditos="8" data-prerequisito="Economía Mexicana I">
                <strong>Economía Mexicana II</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Econ. Mexicana I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Finanzas Públicas" data-creditos="9">
                <strong>Finanzas Públicas</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa II" data-creditos="6">
                <strong>Optativa II</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 6to Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">6to Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Internacional I" data-creditos="9">
                <strong>Economía Internacional I</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Macroeconomía III" data-creditos="10" data-prerequisito="Macroeconomía II">
                <strong>Macroeconomía III</strong><br />(10 Cr.)
                <span class="prerequisito-text">Req: Macroeconomía II</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Análisis de Series de Tiempo" data-creditos="8" data-prerequisito="Econometría I">
                <strong>Series de Tiempo</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Econometría I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Econometría II" data-creditos="8" data-prerequisito="Econometría I">
                <strong>Econometría II</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Econometría I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Seminario de Investigación" data-creditos="7">
                <strong>Seminario de Inv.</strong><br />(7 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Planeación, program. y presup." data-creditos="8">
                <strong>Planeación y Presup.</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa III" data-creditos="6">
                <strong>Optativa III</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 7mo Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">7mo Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Internacional II" data-creditos="9" data-prerequisito="Economía Internacional I">
                <strong>Economía Int. II</strong><br />(9 Cr.)
                <span class="prerequisito-text">Req: Econ. Int. I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Crecimiento Económico" data-creditos="9">
                <strong>Crecimiento Económico</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Política Económica" data-creditos="8">
                <strong>Política Económica</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-terminal" data-nombre="Servicio Social" data-creditos="12">
                <strong>Servicio Social</strong><br />(12 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa IV" data-creditos="6">
                <strong>Optativa IV</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 8vo Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">8vo Periodo</div>
            <div class="materia-card bg-terminal" data-nombre="Práctica profesional" data-creditos="12">
                <strong>Práctica profesional</strong><br />(12 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Desarrollo Económico" data-creditos="9" data-prerequisito="Crecimiento Económico">
                <strong>Desarrollo Económico</strong><br />(9 Cr.)
