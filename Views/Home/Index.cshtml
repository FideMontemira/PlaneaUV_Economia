<!-- Offcanvas de Alertas -->
<div class="offcanvas offcanvas-end shadow" tabindex="-1" id="offcanvasAlertas" aria-labelledby="offcanvasAlertasLabel" style="width: 400px;">
    <div class="offcanvas-header bg-dark text-white">
        <h5 class="offcanvas-title fw-bold" id="offcanvasAlertasLabel">
            <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> Centro de Alertas
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
