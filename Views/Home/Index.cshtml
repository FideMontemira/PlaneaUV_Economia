                            <div class="col-md-6">
                                <label class="form-label fw-bold">Estado de Asistencia:</label>
                                <select class="form-select" id="asistenciaTutoria3" onchange="marcarCambios()">
                                    <option value="pendiente" selected>Pendiente de realizar</option>
                                    <option value="asistio">✅ Asistió</option>
