        </div>

        <!-- 3er Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">3er Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Microeconomía I" data-creditos="10">
                <strong>Microeconomía I</strong><br />(10 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Cálculo II" data-creditos="9" data-prerequisito="Cálculo I">
                <strong>Cálculo II</strong><br />(9 Cr.)
                <span class="prerequisito-text">Req: Cálculo I</span>
            </div>
            <div class="materia-card bg-basica" data-nombre="Probabilidad" data-creditos="8">
                <strong>Probabilidad</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Historia Económica General" data-creditos="8">
                <strong>Hist. Econ. General</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Acreditación de la lengua" data-creditos="8">
                <strong>Acreditación lengua</strong><br />(8 Cr.)
            </div>
        </div>

        <!-- 4to Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">4to Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Microeconomía II" data-creditos="10" data-prerequisito="Microeconomía I">
                <strong>Microeconomía II</strong><br />(10 Cr.)
                <span class="prerequisito-text">Req: Microeconomía I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Macroeconomía I" data-creditos="10">
                <strong>Macroeconomía I</strong><br />(10 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Estadística" data-creditos="8" data-prerequisito="Probabilidad">
                <strong>Estadística</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Probabilidad</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Mexicana I" data-creditos="8">
                <strong>Economía Mexicana I</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Técnicas de Investigación" data-creditos="8">
                <strong>Técnicas de Invest.</strong><br />(8 Cr.)
            </div>
        </div>

        <!-- 5to Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">5to Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Organización Industrial" data-creditos="8" data-prerequisito="Microeconomía II">
                <strong>Organización Industrial</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Microeconomía II</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Microeconomía III" data-creditos="9" data-prerequisito="Microeconomía II">
                <strong>Microeconomía III</strong><br />(9 Cr.)
                <span class="prerequisito-text">Req: Microeconomía II</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Macroeconomía II" data-creditos="10" data-prerequisito="Macroeconomía I">
                <strong>Macroeconomía II</strong><br />(10 Cr.)
                <span class="prerequisito-text">Req: Macroeconomía I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Econometría I" data-creditos="8" data-prerequisito="Estadística">
                <strong>Econometría I</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Estadística</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Modelos Dinámicos" data-creditos="8">
                <strong>Modelos Dinámicos</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Mexicana II" data-creditos="8" data-prerequisito="Economía Mexicana I">
                <strong>Economía Mexicana II</strong><br />(8 Cr.)
                <span class="prerequisito-text">Req: Econ. Mexicana I</span>
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Finanzas Públicas" data-creditos="9">
                <strong>Finanzas Públicas</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa II" data-creditos="6">
                <strong>Optativa II</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 6to Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">6to Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Economía Internacional I" data-creditos="9">
