@{
    ViewData["Title"] = "Mapa Curricular - Economía";
}

<style>
    /* Estructura del Grid */
    .mapa-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 15px;
        overflow-x: auto;
        padding: 20px 0;
        min-width: 1200px;
    }

    .periodo-columna {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .periodo-header {
        text-align: center;
        font-weight: bold;
        background-color: #343a40;
        color: white;
        padding: 5px;
        border-radius: 5px;
        font-size: 0.9rem;
    }

    .materia-card {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        text-align: center;
        font-size: 0.85rem;
        cursor: pointer;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.05);
        transition: transform 0.2s;
        min-height: 80px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

        .materia-card:hover {
            transform: scale(1.05);
            box-shadow: 2px 2px 10px rgba(0,0,0,0.15);
        }

    /* Colores base por Área */
    .bg-basica {
        background-color: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }

    .bg-optativa {
        background-color: #cce5ff;
        border-color: #007bff;
        color: #004085;
    }

    .bg-disciplinar {
        background-color: #d4edda;
        border-color: #28a745;
        color: #155724;
    }

    .bg-general {
        background-color: #f8f9fa;
        border-color: #6c757d;
        color: #383d41;
    }

    .bg-terminal {
        background-color: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    /* Estados visuales de Aprobación / Reprobación */
    .estado-aprobada {
        border: 3px solid #28a745 !important;
        opacity: 0.7;
    }

        .estado-aprobada::after {
            content: '✅ Aprobada';
            display: block;
            font-size: 0.75rem;
            color: #155724;
            font-weight: bold;
            margin-top: 8px;
        }

    .estado-reprobada {
        border: 3px solid #dc3545 !important;
    }

        .estado-reprobada::after {
            content: '❌ Reprobada';
            display: block;
            font-size: 0.75rem;
            color: #721c24;
            font-weight: bold;
            margin-top: 8px;
        }

    .prerequisito-text {
        font-size: 0.7rem;
        color: #dc3545;
        font-weight: bold;
        margin-top: 5px;
    }
</style>

<div class="container-fluid">

    <!-- Panel de Búsqueda de Alumno -->
