@{
    ViewData["Title"] = "Mapa Curricular - Economía";
}

<style>
    /* Estructura del Grid */
    .mapa-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 15px;
        overflow-x: auto;
        padding: 20px 0;
        min-width: 1200px;
    }

    .periodo-columna {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .periodo-header {
        text-align: center;
        font-weight: bold;
        background-color: #343a40;
        color: white;
        padding: 5px;
        border-radius: 5px;
        font-size: 0.9rem;
    }

    .materia-card {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 8px;
        text-align: center;
        font-size: 0.8rem;
        cursor: pointer;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.05);
        transition: transform 0.2s;
        min-height: 85px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

        .materia-card:hover {
            transform: scale(1.05);
            box-shadow: 2px 2px 10px rgba(0,0,0,0.15);
        }

    /* Colores base por Área */
    .bg-basica {
        background-color: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }

    .bg-optativa {
        background-color: #cce5ff;
        border-color: #007bff;
        color: #004085;
    }

    .bg-disciplinar {
        background-color: #d4edda;
        border-color: #28a745;
        color: #155724;
    }

    .bg-general {
        background-color: #f8f9fa;
        border-color: #6c757d;
        color: #383d41;
    }

    .bg-terminal {
        background-color: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    /* Estados visuales de Aprobación / Reprobación */
    .estado-aprobada {
        border: 3px solid #28a745 !important;
        opacity: 0.75;
    }

    .estado-reprobada {
        border: 3px solid #dc3545 !important;
    }

    /* Insignias informativas directas en la tarjeta */
    .badge-info-materia {
        font-size: 0.65rem;
        background-color: rgba(0,0,0,0.08);
        padding: 2px 4px;
        border-radius: 3px;
        margin-top: 4px;
        font-weight: bold;
    }

    .prerequisito-text {
        font-size: 0.65rem;
        color: #dc3545;
        font-weight: bold;
        margin-top: 3px;
    }
</style>

<div class="container-fluid">

    <!-- Panel de Búsqueda de Alumno -->
    <div class="card my-4 shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-end gap-3">
            <div class="d-flex gap-3 flex-grow-1">
                <div class="flex-grow-1" style="max-width: 250px;">
                    <label class="form-label fw-bold">Matrícula:</label>
                    <input type="text" id="inputMatricula" class="form-control" placeholder="Ej. S20012345">
                </div>
                <div class="flex-grow-1">
                    <label class="form-label fw-bold">Nombre del Alumno:</label>
                    <input type="text" id="inputNombreAlumno" class="form-control" placeholder="Nombre completo del alumno">
                </div>
            </div>
            <div>
                <button class="btn btn-primary me-2" onclick="buscarAlumno()">Buscar / Cargar Alumno</button>
                <button class="btn btn-success" onclick="exportarAvance()">Exportar Avance a Excel</button>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <h2 class="display-6">Mapa Curricular - Licenciatura en Economía (Plan 2024)</h2>
        <p>Haz clic en una materia para gestionar el avance del estudiante.</p>
    </div>

    <!-- Contenedor del Mapa (Grid Estático) -->
    <div class="mapa-grid">
        <!-- 1er Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">1er Periodo</div>
            <div class="materia-card bg-general" data-nombre="Lengua I" data-creditos="4">
                <strong>Lengua I</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Literacidad Digital" data-creditos="4">
                <strong>Literacidad Digital</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Lectura y escritura de textos" data-creditos="4">
                <strong>Lectura y escritura</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Introducción a la Economía" data-creditos="6">
                <strong>Introducción a la Economía</strong><br />(6 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa I" data-creditos="6">
                <strong>Optativa I</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 2do Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">2do Periodo</div>
            <div class="materia-card bg-general" data-nombre="Lengua II" data-creditos="4" data-prerequisito="Lengua I">
                <strong>Lengua II</strong><br />(4 Cr.)
                <span class="prerequisito-text">Req: Lengua I</span>
            </div>
            <div class="materia-card bg-general" data-nombre="Pensamiento Crítico" data-creditos="4">
                <strong>Pensamiento Crítico</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Cálculo I" data-creditos="9">
                <strong>Cálculo I</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Álgebra Lineal" data-creditos="9">
                <strong>Álgebra Lineal</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Historia del Pensamiento Económico" data-creditos="8">
                <strong>Hist. Pensamiento Econ.</strong><br />(8 Cr.)
            </div>
        </div>

        <!-- 3er Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">3er Periodo</div>
            <div class="materia-card bg-disciplinar" data-nombre="Microeconomía I" data-creditos="10">
                <strong>Microeconomía I</strong><br />(10 Cr.)
            </div>
            <div class="materia-card bg-disciplinar" data-nombre="Cálculo II" data-creditos="9" data-prerequisito="Cálculo I">
                <strong>Cálculo II</strong><br />(9 Cr.)
                <span class="prerequisito-text">Req: Cálculo I</span>
            </div>
            <div class="materia-card bg-basica" data-nombre="Probabilidad" data-creditos="8">
                <strong>Probabilidad</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Historia Económica General" data-creditos="8">
                <strong>Hist. Econ. General</strong><br />(8 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Acreditación de la lengua" data-creditos="8">
