@{
    ViewData["Title"] = "Mapa Curricular - Economía";
}

<style>
    /* Estructura del Grid */
    .mapa-grid {
        display: grid;
        grid-template-columns: repeat(8, 1fr);
        gap: 15px;
        overflow-x: auto;
        padding: 20px 0;
        min-width: 1200px;
    }

    .periodo-columna {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .periodo-header {
        text-align: center;
        font-weight: bold;
        background-color: #343a40;
        color: white;
        padding: 5px;
        border-radius: 5px;
        font-size: 0.9rem;
    }

    .materia-card {
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 8px;
        text-align: center;
        font-size: 0.8rem;
        cursor: pointer;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
        min-height: 85px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        position: relative;
    }

        .materia-card:not(.estado-aprobada):not(.estado-bloqueada):hover {
            transform: scale(1.05);
            box-shadow: 2px 2px 10px rgba(0,0,0,0.15);
        }

    /* Colores base por Área */
    .bg-basica {
        background-color: #fff3cd;
        border-color: #ffc107;
        color: #856404;
    }

    .bg-optativa {
        background-color: #cce5ff;
        border-color: #007bff;
        color: #004085;
    }

    .bg-disciplinar {
        background-color: #d4edda;
        border-color: #28a745;
        color: #155724;
    }

    .bg-general {
        background-color: #f8f9fa;
        border-color: #6c757d;
        color: #383d41;
    }

    .bg-terminal {
        background-color: #f8d7da;
        border-color: #dc3545;
        color: #721c24;
    }

    /* Estados visuales de Materias */
    .estado-reprobada {
        border: 3px solid #dc3545 !important;
    }

    .estado-cursando {
        border: 3px dashed #0dcaf0 !important;
        box-shadow: 0 0 12px rgba(13, 202, 240, 0.4) !important;
    }

    /* MODIFICADO: Aprobada en gris, sin animación pero clickeable (por si se necesita corregir) */
    .estado-aprobada {
        border: 3px solid #28a745 !important;
        background-color: #f8f9fa !important;
        color: #6c757d !important;
        opacity: 0.85;
    }

    /* NUEVO: Bloqueada por prerrequisito activo */
    .estado-bloqueada {
        background-color: #e9ecef !important;
        border-color: #ced4da !important;
        color: #adb5bd !important;
        opacity: 0.6;
        cursor: not-allowed !important;
    }

    .badge-info-materia {
        font-size: 0.65rem;
        background-color: rgba(0,0,0,0.08);
        padding: 2px 4px;
        border-radius: 3px;
        margin-top: 4px;
        font-weight: bold;
    }

    .prerequisito-text {
        font-size: 0.65rem;
        color: #dc3545;
        font-weight: bold;
        margin-top: 3px;
    }

    /* ESTILOS PARA LAS GRÁFICAS DEL DASHBOARD */
    .progress-circle {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        background: conic-gradient(#e9ecef 100%, #e9ecef 0%);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.4s ease;
    }

    .progress-circle-inner {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background-color: white;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .riesgo-circle, .curso-circle {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .riesgo-circle {
        background-color: #fff3cd;
        border: 3px solid #ffc107;
    }

    .curso-circle {
        background-color: #e0f8fd;
        border: 3px dashed #0dcaf0;
    }

    #listaAlumnosModal {
        max-height: 220px;
        overflow-y: auto;
        padding-right: 5px;
    }

    /* ANIMACIÓN PARA RESALTAR MATERIA EN ALERTA */
    @@keyframes parpadeoAlerta {
        0% {
            box-shadow: 0 0 0px rgba(220, 53, 69, 0);
            transform: scale(1);
        }

        50% {
            box-shadow: 0 0 20px rgba(220, 53, 69, 0.9);
            transform: scale(1.08);
            border-color: #dc3545;
            background-color: #fff8f8;
            z-index: 10;
        }

        100% {
            box-shadow: 0 0 0px rgba(220, 53, 69, 0);
            transform: scale(1);
        }
    }

    .resaltado-alerta {
        animation: parpadeoAlerta 1s ease-in-out 3;
    }

    #tutoriasTabs .nav-link {
        color: #6c757d;
    }

        #tutoriasTabs .nav-link.active {
            color: #0dcaf0;
            border-bottom: 3px solid #0dcaf0;
        }
</style>

<div class="container-fluid">

    <!-- Panel de Búsqueda de Alumno y Gráficas -->
    <div class="card my-4 shadow-sm">
        <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex gap-2 flex-grow-1 align-items-end">
                <div class="dropdown">
                    <button class="btn btn-outline-secondary fs-5 py-1 px-2 mb-1" type="button" id="dropdownAlumnos" data-bs-toggle="dropdown" aria-expanded="false" style="border: none;" title="Ver alumnos guardados">
                        ⋮
                    </button>
                    <ul class="dropdown-menu shadow" aria-labelledby="dropdownAlumnos" id="listaAlumnosRegistrados">
                        <li><span class="dropdown-item-text text-muted">Cargando...</span></li>
                    </ul>
                </div>

                <div style="max-width: 150px;">
                    <label class="form-label fw-bold">Matrícula:</label>
                    <input type="text" id="inputMatricula" class="form-control" placeholder="Matrícula" readonly>
                </div>
                <div class="flex-grow-1" style="max-width: 300px;">
                    <label class="form-label fw-bold">Nombre del Alumno:</label>
                    <input type="text" id="inputNombreAlumno" class="form-control" placeholder="Nombre completo" readonly>
                </div>
            </div>

            <div class="d-flex align-items-center gap-4 bg-light p-2 px-4 rounded border">
                <div class="d-flex align-items-center gap-3">
                    <div class="progress-circle" id="graficaAvance">
                        <div class="progress-circle-inner">
                            <span id="textoPorcentaje" class="fw-bold fs-5 text-dark mb-0">0%</span>
                        </div>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-muted" style="font-size: 0.85rem;">AVANCE CREDITICIO</h6>
                        <span id="textoCreditos" class="text-primary fw-bold" style="font-size: 1.15rem;">0 / 348 Cr.</span>
                    </div>
                </div>

                <div class="vr bg-secondary" style="width: 2px;"></div>

                <div class="d-flex align-items-center gap-2">
                    <div class="curso-circle shadow-sm">
                        <span id="textoCurso" class="text-info fw-bold mb-0" style="font-size: 1.3rem;">0</span>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-info" style="font-size: 0.85rem;">EN CURSO</h6>
                        <span class="text-muted fw-bold" style="font-size: 0.75rem;">Materias</span>
                    </div>
                </div>

                <div class="vr bg-secondary" style="width: 2px;"></div>

                <div class="d-flex align-items-center gap-2">
                    <div class="riesgo-circle shadow-sm">
                        <span id="textoRiesgo" class="text-danger fw-bold mb-0" style="font-size: 1.3rem;">0</span>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-danger" style="font-size: 0.85rem;">EN RIESGO</h6>
                        <span class="text-muted fw-bold" style="font-size: 0.75rem;">Materias</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 h-100 align-items-stretch">
                <button class="btn btn-info fw-bold px-3 text-white" type="button" onclick="abrirModalTutorias()">
                    <i class="bi bi-journal-text me-1"></i> Tutorías
                </button>
                <button class="btn btn-warning fw-bold px-3 position-relative" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasAlertas" aria-controls="offcanvasAlertas" onclick="cargarAlertas()">
                    <i class="bi bi-bell-fill"></i> Alertas
                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="contadorAlertas" style="display: none;">
                        0
                    </span>
                </button>
                <button class="btn btn-success fw-bold px-4" onclick="exportarAvance()">
                    <i class="bi bi-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>

    <div class="text-center mb-4">
        <h2 class="display-6">Mapa Curricular - Licenciatura en Economía (Plan 2024)</h2>
        <p>Haz clic en una materia para gestionar el avance del estudiante.</p>
    </div>

    <div class="mapa-grid">
        <!-- 1er Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">1er Periodo</div>
            <div class="materia-card bg-general" data-nombre="Lengua I" data-creditos="4">
                <strong>Lengua I</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Literacidad Digital" data-creditos="4">
                <strong>Literacidad Digital</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-general" data-nombre="Lectura y escritura de textos" data-creditos="4">
                <strong>Lectura y escritura</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Introducción a la Economía" data-creditos="6">
                <strong>Introducción a la Economía</strong><br />(6 Cr.)
            </div>
            <div class="materia-card bg-optativa" data-nombre="Optativa I" data-creditos="6">
                <strong>Optativa I</strong><br />(6 Cr.)
            </div>
        </div>

        <!-- 2do Periodo -->
        <div class="periodo-columna">
            <div class="periodo-header">2do Periodo</div>
            <div class="materia-card bg-general" data-nombre="Lengua II" data-creditos="4" data-prerequisito="Lengua I">
                <strong>Lengua II</strong><br />(4 Cr.)
                <span class="prerequisito-text">Req: Lengua I</span>
            </div>
            <div class="materia-card bg-general" data-nombre="Pensamiento Crítico" data-creditos="4">
                <strong>Pensamiento Crítico</strong><br />(4 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Cálculo I" data-creditos="9">
                <strong>Cálculo I</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Álgebra Lineal" data-creditos="9">
                <strong>Álgebra Lineal</strong><br />(9 Cr.)
            </div>
            <div class="materia-card bg-basica" data-nombre="Historia del Pensamiento Económico" data-creditos="8">
                <strong>Hist. Pensamiento Econ.</strong><br />(8 Cr.)
