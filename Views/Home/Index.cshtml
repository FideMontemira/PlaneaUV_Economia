<!-- Modal para Gestión de Avance -->
<div class="modal fade" id="modalAvance" tabindex="-1" aria-labelledby="modalAvanceLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalMateriaNombre">Nombre de la Materia</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p><strong>Créditos:</strong> <span id="modalMateriaCreditos"></span></p>

                <div class="mb-3 d-none" id="divOptativa">
                    <label class="form-label fw-bold text-primary">Nombre de la Optativa:</label>
                    <input type="text" class="form-control" id="inputOptativa" placeholder="Ej. Finanzas Internacionales">
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Tipo de Inscripción:</label>
                    <select class="form-select" id="selectInscripcion">
                        <option value="primera">Primera inscripción</option>
                        <option value="segunda">Segunda inscripción</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Último Examen Presentado:</label>
                    <select class="form-select" id="selectExamen">
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Estado de la Materia:</label>
                    <select class="form-select" id="selectAprobacion">
                        <option value="ninguno" selected disabled>Seleccione el estado...</option>
                        <option value="cursando"> Cursando actualmente (Semestre en curso)</option>
                        <option value="si"> Aprobada</option>
                        <option value="no"> Reprobada</option>
                    </select>
                </div>

                <div class="form-check mt-4 mb-2 border p-2 rounded bg-light border-warning">
                    <input class="form-check-input ms-1" type="checkbox" id="checkRiesgo">
                    <label class="form-check-label fw-bold text-danger ms-2" for="checkRiesgo">
                        ⚠️ Materia en riesgo de ser reprobada
                    </label>
                </div>

                <div id="alertaEstatus" class="alert d-none mt-3" role="alert"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="guardarAvance()">Confirmar Materia</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Tutorías -->
<div class="modal fade" id="modalTutorias" tabindex="-1" aria-labelledby="modalTutoriasLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold" id="modalTutoriasLabel">
                    <i class="bi bi-journal-text me-2"></i> Registro de Tutorías del Semestre
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-0 bg-light">
                <ul class="nav nav-tabs nav-fill bg-white pt-2 border-bottom-0" id="tutoriasTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="sesion1-tab" data-bs-toggle="tab" data-bs-target="#sesion1" type="button" role="tab" aria-controls="sesion1" aria-selected="true">
                            <i class="bi bi-1-circle-fill me-1"></i> Primera Sesión
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
