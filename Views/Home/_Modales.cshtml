<!-- Modal Inicio -->
<div class="modal fade" id="modalInicio" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="modalInicioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalInicioLabel"><i class="bi bi-person-lines-fill me-2"></i>Seleccionar Alumno</h5>
                <button type="button" class="btn-close btn-close-white d-none" id="btnCerrarModalInicio" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <ul class="nav nav-pills nav-fill mb-3" id="pills-tab" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold" id="pills-buscar-tab" data-bs-toggle="pill" data-bs-target="#pills-buscar" type="button" role="tab"><i class="bi bi-search me-1"></i> Buscar Existente</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-success" id="pills-nuevo-tab" data-bs-toggle="pill" data-bs-target="#pills-nuevo" type="button" role="tab"><i class="bi bi-plus-circle me-1"></i> Alumno Nuevo</button>
                    </li>
                </ul>
                <div class="tab-content" id="pills-tabContent">
                    <div class="tab-pane fade show active" id="pills-buscar" role="tabpanel">
                        <input type="text" class="form-control mb-3 border-primary" id="inputBuscarAlumnoModal" placeholder="Escribe para filtrar alumnos..." onkeyup="filtrarAlumnosModal()">
                        <div class="list-group shadow-sm" id="listaAlumnosModal" style="max-height: 200px; overflow-y: auto;">
                        </div>
                    </div>
                    <div class="tab-pane fade" id="pills-nuevo" role="tabpanel">
                        <div class="alert alert-success small py-2 mb-3"><i class="bi bi-info-circle-fill me-1"></i> Registra la matrícula y nombre para crear el expediente.</div>
                        <div class="mb-2">
                            <label class="form-label fw-bold small">Matrícula</label>
                            <input type="text" class="form-control border-success fw-bold" id="inputNuevaMatricula" placeholder="Ej. S22014022">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Nombre Completo</label>
                            <input type="text" class="form-control border-success" id="inputNuevoNombre" placeholder="Empezando por apellidos">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold small">Plan de Estudios</label>
                            <select class="form-select border-success" id="selectPlanNuevoAlumno">
                                <option value="">-- Selecciona el Plan --</option>
                            </select>
                        </div>
                        <button class="btn btn-success w-100 fw-bold shadow-sm" onclick="crearNuevoAlumno()"><i class="bi bi-person-plus-fill me-1"></i> Crear y Empezar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Avance (Máquina del Tiempo) -->
<div class="modal fade" id="modalAvance" tabindex="-1" aria-labelledby="modalAvanceLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title mb-0" id="modalMateriaNombre">Nombre de la Materia</h5>
                    <small id="modalPeriodoVinculado" class="text-light opacity-75">Periodo: Agosto - Enero 2027</small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge bg-dark fs-6" id="modalMateriaCreditos">X Cr.</span>
                    <button class="btn btn-sm btn-outline-danger" onclick="limpiarEstadoMateria()" title="Borrar historial y reiniciar materia">
                        <i class="bi bi-eraser-fill"></i> Limpiar Materia
                    </button>
                </div>

                <div class="mb-3 d-none" id="divOptativa">
                    <label class="form-label fw-bold text-primary small">Seleccionar Optativa:</label>
                    <!-- Las opciones salen de la hoja "Optativas" del plan de estudios (ver llenarSelectOptativas en el JS) -->
                    <select class="form-select form-select-sm border-primary fw-bold text-dark" id="inputOptativa">
                        <option value="">-- Seleccione la experiencia educativa --</option>
                    </select>
                </div>
                <div class="mb-3 d-none" id="divAfel">
                    <label class="form-label fw-bold text-success small">Nombre del AFEL:</label>
                    <input type="text" class="form-control form-control-sm border-success mb-2" id="inputNombreAfel" placeholder="Ej. Arte y Creatividad, Deporte, etc.">

                    <label class="form-label fw-bold text-success small">Créditos que otorga:</label>
                    <input type="number" class="form-control form-control-sm border-success" id="inputCreditosAfel" min="1" max="20" placeholder="Ej. 6">
                </div>

                <!-- Historial de Intentos -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-bold small py-2 text-muted">
                        <i class="bi bi-clock-history"></i> Historial de Intentos
                    </div>
                    <ul class="list-group list-group-flush small" id="listaHistorialIntentos">
                        <li class="list-group-item text-center text-muted">No hay intentos registrados.</li>
                    </ul>
                </div>

                <!-- Registrar Nuevo Intento -->
                <div class="card border-primary shadow-sm mb-2">
                    <div class="card-header bg-primary text-white fw-bold small py-2">
                        <i class="bi bi-plus-circle"></i> Registrar Estado / Intento
                    </div>
                    <div class="card-body p-3">
                        <div class="row g-2 mb-2">
                            <div class="col-6">
                                <label class="form-label fw-bold small mb-1">Inscripción:</label>
                                <select class="form-select form-select-sm" id="selectInscripcion">
                                    <option value="primera">1ra Inscripción</option>
                                    <option value="segunda">2da Inscripción</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold small mb-1">Examen / Vía:</label>
                                <select class="form-select form-select-sm" id="selectExamen">
                                    <option value="ordinario">Ordinario</option>
                                    <option value="extraordinario">Extraordinario</option>
                                    <option value="titulo">Título de Suficiencia</option>
                                    <option value="ultima">Última Oportunidad</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-0">
                            <label class="form-label fw-bold small mb-1">Resultado:</label>
                            <select class="form-select form-select-sm border-dark" id="selectAprobacion">
                                <option value="ninguno" selected>Seleccione...</option>
                                <option value="cursando"> Cursando actualmente</option>
                                <option value="si"> Aprobada</option>
                                <option value="no"> Reprobada</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-3">
                    <div class="form-check border p-2 rounded bg-white border-warning flex-fill shadow-sm">
                        <input class="form-check-input ms-1" type="checkbox" id="checkRiesgo">
                        <label class="form-check-label fw-bold text-danger ms-2 small" for="checkRiesgo"> Riesgo Manual</label>
                    </div>
                    <div class="form-check border p-2 rounded bg-white border-secondary flex-fill shadow-sm">
                        <input class="form-check-input ms-1" type="checkbox" id="checkRezago">
                        <label class="form-check-label fw-bold text-secondary ms-2 small" for="checkRezago"> En Rezago</label>
                    </div>
                </div>

                <div id="alertaEstatus" class="alert d-none mt-3 py-2 small" role="alert"></div>

                <button type="button" id="btnSiguienteOp" class="btn btn-warning btn-sm fw-bold w-100 mt-2 d-none shadow-sm" onclick="prepararSiguienteOportunidad()">
                    <i class="bi bi-fast-forward-fill"></i> Siguiente Oportunidad
                </button>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm fw-bold" onclick="guardarAvance()">
                    <i class="bi bi-save"></i> Guardar Materia
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Las tutorías tienen su propia pantalla: Views/Home/Tutoria.cshtml -->

<!-- Modal Reporte Global -->
<div class="modal fade" id="modalReporteGlobal" tabindex="-1" aria-labelledby="modalReporteGlobalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header text-white" style="background-color: #6f42c1;">
                <h5 class="modal-title" id="modalReporteGlobalLabel"><i class="bi bi-bar-chart-line-fill me-2"></i>Reporte Global de Trayectorias</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="card h-100 border-warning shadow-sm">
                            <div class="card-header bg-warning text-dark fw-bold"><i class="bi bi-exclamation-triangle-fill me-2"></i>Materias en Riesgo</div>
                            <div class="card-body" id="contenedorReporteRiesgo"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-secondary shadow-sm">
                            <div class="card-header bg-secondary text-white fw-bold"><i class="bi bi-hourglass-split me-2"></i>Materias en Rezago</div>
                            <div class="card-body" id="contenedorReporteRezago"></div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card h-100 border-danger shadow-sm">
                            <div class="card-header bg-danger text-white fw-bold"><i class="bi bi-lock-fill me-2"></i>Seriadas Adeudadas (Candados)</div>
                            <div class="card-body" id="contenedorReporteSeriadas"></div>
                        </div>
                    </div>
                    <div class="col-12 order-first">
                        <div class="card border-dark shadow-sm">
                            <div class="card-header bg-dark text-white fw-bold d-flex flex-wrap justify-content-between gap-2">
                                <span><i class="bi bi-fire me-2"></i>Reprobación por materia</span>
                                <small class="fw-normal opacity-75" id="criterioMateriasCriticas"></small>
                            </div>
                            <div class="card-body rejilla-criticas" id="contenedorReporteCriticas"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-white">
                <button type="button" class="btn btn-primary" onclick="imprimirReporteGlobal()"><i class="bi bi-printer-fill me-1"></i> Imprimir Reporte</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Offcanvas Alertas -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAlertas" aria-labelledby="offcanvasAlertasLabel">
    <div class="offcanvas-header bg-warning text-dark border-bottom">
        <h5 class="offcanvas-title fw-bold" id="offcanvasAlertasLabel"><i class="bi bi-bell-fill me-2"></i>Alertas del Sistema</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body bg-light" id="contenedorTarjetasAlerta">
        <div class="text-center py-4"><div class="spinner-border text-warning" role="status"></div></div>
    </div>
</div>
<!-- Modal Gestor de Planes de Estudio -->
<div class="modal fade" id="modalGestorPlanes" tabindex="-1" aria-labelledby="modalGestorPlanesLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title" id="modalGestorPlanesLabel">
                    <i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Gestor de Planes
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="alert alert-info small py-2 shadow-sm">
                    <i class="bi bi-info-circle-fill me-1"></i> Sube la plantilla de Excel <b>(.xlsx)</b> con las 5 columnas base para que el sistema aprenda a dibujar el mapa curricular automáticamente.
                </div>
                <div class="mb-3 mt-3">
                    <label class="form-label fw-bold small text-dark">Archivo de Plantilla Excel:</label>
                    <input class="form-control border-primary shadow-sm" type="file" id="inputFilePlan" accept=".xlsx">
                </div>
                <button class="btn btn-primary w-100 fw-bold shadow-sm" onclick="subirPlanEstudio()">
                    <i class="bi bi-cloud-arrow-up-fill me-1"></i> Subir y Guardar Plan
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Periodos sin inscripción (bajas temporales) -->
<div class="modal fade" id="modalPausas" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-secondary text-white">
                <h5 class="modal-title"><i class="bi bi-pause-circle me-2"></i>Periodos sin inscripción</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="alert alert-info small py-2">
                    Marca los periodos en que el alumno <strong>no estuvo inscrito</strong> (baja temporal, pausa).
                    Esos periodos no cuentan para saber en qué periodo va, así no aparece con rezago que no le corresponde.
                </div>
                <div id="listaPausas" class="list-group shadow-sm"></div>
            </div>
            <div class="modal-footer bg-white">
                <span class="small text-muted me-auto" id="resumenPausas"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Sugerencia de carga -->
<div class="modal fade" id="modalSugerencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <div>
                    <h5 class="modal-title mb-0"><i class="bi bi-lightbulb-fill me-2"></i>Sugerencia de carga</h5>
                    <small id="subtituloSugerencia" class="opacity-75"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="d-flex align-items-end gap-3 mb-3">
                    <div>
                        <label class="form-label fw-bold small mb-1">Máximo de créditos a inscribir:</label>
                        <input type="number" class="form-control form-control-sm fw-bold" id="inputMaxCreditos" min="1" max="200" style="max-width: 140px;" onchange="calcularSugerenciaCarga()">
                    </div>
                    <div class="small text-muted">
                        Solo se sugieren materias que el alumno <strong>ya puede cursar</strong> (prerrequisitos aprobados).
                        Primero las atrasadas que bloquean a otras, luego el resto del rezago y al final las de su periodo.
                    </div>
                </div>
                <div id="contenedorSugerencia"></div>
            </div>
            <div class="modal-footer bg-white">
                <span class="fw-bold me-auto" id="totalSugerencia"></span>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Panel del Grupo -->
<div class="modal fade" id="modalPanelGrupo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <div>
                    <h5 class="modal-title mb-0"><i class="bi bi-people-fill me-2"></i>Panel del grupo</h5>
                    <small id="subtituloPanelGrupo" class="opacity-75"></small>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
                    <input type="text" class="form-control form-control-sm" id="filtroPanelGrupo" placeholder="Filtrar por matrícula, nombre o programa..." style="max-width: 320px;" oninput="dibujarPanelGrupo()">
                    <div class="form-check form-switch ms-2">
                        <input class="form-check-input" type="checkbox" id="soloActivosPanelGrupo" checked onchange="dibujarPanelGrupo()">
                        <label class="form-check-label small" for="soloActivosPanelGrupo">Solo activos</label>
                    </div>
                    <span class="small text-muted ms-auto" id="resumenPanelGrupo"></span>
                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="abrirReportesDelGrupo()" title="Reporte del periodo de cada alumno activo, para imprimir o guardar en PDF">
                        <i class="bi bi-printer me-1"></i>Reportes del periodo (todos)
                    </button>
                </div>
                <div class="table-responsive bg-white rounded shadow-sm">
                    <table class="table table-sm table-hover align-middle mb-0" id="tablaPanelGrupo">
                        <thead class="table-dark">
                            <tr>
                                <th role="button" data-columna="nivelSemaforo" class="text-center">Semáforo</th>
                                <th role="button" data-columna="matricula">Matrícula</th>
                                <th role="button" data-columna="nombre">Nombre</th>
                                <th role="button" data-columna="programa">Programa</th>
                                <th role="button" data-columna="situacion">Situación</th>
                                <th role="button" data-columna="periodoQueCursa" class="text-center">Periodo</th>
                                <th role="button" data-columna="avance" style="min-width: 150px;">Avance</th>
                                <th role="button" data-columna="enCurso" class="text-center">En curso</th>
                                <th role="button" data-columna="rezago" class="text-center">Rezago</th>
                                <th role="button" data-columna="alertas" class="text-center">Alertas</th>
                                <th role="button" data-columna="estadoCaso" class="text-center">Caso</th>
                                <th role="button" data-columna="diasSinContacto" class="text-center" title="Días desde la última tutoría a la que asistió">Último contacto</th>
                                <th class="text-center">Tutoría</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <p class="small text-muted mt-2 mb-0">Clic en un encabezado para ordenar. Clic en un alumno para abrir su mapa.</p>
            </div>
        </div>
    </div>
</div>
