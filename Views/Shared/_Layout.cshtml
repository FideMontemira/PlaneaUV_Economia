<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#18529d" />
    <title>@ViewData["Title"] - PlaneaUV</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons incluida en el proyecto (funciona sin internet); sin ella los <i class="bi ..."> salen vacíos -->
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlaneaUV_Economia.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Barra superior fija. Cada página puede agregar sus propios elementos con la sección "NavItems";
             en pantallas chicas se pliegan en el menú hamburguesa. -->
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar sticky-top shadow-sm">
            <div class="container-fluid app-contenedor">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2"></i>PlaneaUV
                    <span class="app-brand-sub d-none d-xl-inline">Universidad Veracruzana · Seguimiento de trayectorias académicas</span>
                </a>
                @if (IsSectionDefined("NavItems"))
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                            aria-controls="menuPrincipal" aria-expanded="false" aria-label="Abrir menú">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="menuPrincipal">
                        @await RenderSectionAsync("NavItems", required: false)
                    </div>
                }
            </div>
        </nav>
    </header>
    <div class="container-fluid app-contenedor">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    @* Tema institucional: va después de las hojas de estilo de cada página para que mande sobre ellas *@
    <link rel="stylesheet" href="~/css/tema-uv.css" asp-append-version="true" />

    <footer class="border-top footer text-muted">
        <div class="container-fluid app-contenedor small">
            <strong>PlaneaUV</strong> · Seguimiento de trayectorias académicas · Universidad Veracruzana &copy; 2026
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
